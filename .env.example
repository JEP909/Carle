# Copy to .env.local and fill in. .env.local is gitignored — never commit keys.

# Required — generation (Anthropic / Claude)
ANTHROPIC_API_KEY=sk-ant-...

# Optional — photoreal {{image}} renders (OpenAI gpt-image-1).
# Without it, image tokens are dropped cleanly and everything else still works.
OPENAI_API_KEY=sk-proj-...

# Optional — default model tier: economy | standard | premium  (default: standard)
CARLE_TIER=standard

# Optional — override just the premium/build model id
# CARLE_BUILD_MODEL=
